# TEM-AI Environment Configuration
# Add your Gemini Pro API key to enable live AI inference.
# If left blank, the application seamlessly runs in high-fidelity DEMO MODE.

# Google Gemini API Key (Gemini 1.5 Pro / Flash)
GEMINI_API_KEY=
# Alternative variable names supported:
# GOOGLE_API_KEY=

# Supabase PostgreSQL (Optional for live multi-user persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
